{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@subproyecto/api-client#generate": {
      "dependsOn": [
        "@subproyecto/api#generate"
      ],
      "cache": false
    }
  }
}
